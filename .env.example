# Base de données — Secret
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/jobpulse

# Authentification et routes internes — Secrets
AUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret
INGEST_API_KEY=replace-with-another-long-random-secret
SLACK_TOKEN_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
APP_URL=http://localhost:3000

# Google OAuth — Secrets
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Slack OAuth — Secrets / configuration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_WEBHOOK_URL=
SLACK_CONTRACTS=stage,alternance,graduate
SYNC_FAILURE_ALERT_THRESHOLD=3

# France Travail — Secrets / configuration
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_API_URL=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search

# Sources facultatives — laisser vide pour désactiver
LA_BONNE_ALTERNANCE_API_KEY=
LA_BONNE_ALTERNANCE_ROMES=M1805,M1806,M1802,M1810
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
SMARTRECRUITERS_COMPANIES=
